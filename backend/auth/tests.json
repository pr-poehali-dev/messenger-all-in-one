{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Неизвестное действие"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Send code - missing phone",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_code"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Введите номер телефона"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Register - wrong code",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "phone": "+79007771122", "display_name": "Тест", "code": "000000"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login - wrong code",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "phone": "+79007771122", "code": "000000"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
